// ============================================================
// CONFIRMED SUNRISE ZONES  |  Pine Script v6
// ============================================================
// Authoritative source : timeanddate.com
// Data delivery        : request.seed() via GitHub CSV
// Cities               : Tokyo | London | New York City
// Timeframe            : 1-minute ONLY
// Rolling window       : 12 calendar days x 3 cities = max 36 boxes
//
// ARCHITECTURE:
//   timeanddate.com
//     -> Python data service (sunrise_fetcher.py)
//     -> GitHub CSV repository (request.seed() format)
//     -> request.seed() calls in this script
//     -> Sunrise zone boxes on the chart
//
// DATA ENCODING (OHLCV slot multiplexing):
//   CSV column  |  Encoded value
//   ------------|-------------------------------------------
//   time        |  UTC ms of the 1-minute candle open
//   open        |  HHMM integer  (05:22 -> 522)
//   high        |  SS integer    (37 seconds)
//   low         |  YYYYMMDD      (local date, 20260914)
//   close       |  Status code   (1=VERIFIED, 2=WARNING, 0=UNAVAILABLE)
//   volume      |  0 (reserved)
//
// CANDLE SELECTION:
//   The seed data timestamp is the candle OPEN time.
//   When request.seed() returns non-na values on a bar, that bar IS
//   the exact 1-minute candle containing the sunrise event.
//   Box top = candle HIGH, box bottom = candle LOW (wick to wick).
//
// FUTURE-DATE PROTECTION:
//   The Python service only writes confirmed past sunrises.
//   The Pine indicator adds a secondary guard: time < timenow.
//
// NO-REPAINTING:
//   Zones are drawn when seed data first appears and never moved.
//   The rolling window only removes dates older than 12 days.
// ============================================================

//@version=6
indicator("Confirmed Sunrise Zones", overlay = true,
          max_boxes_count  = 50,
          max_labels_count = 50,
          max_lines_count  = 0)

// ────────────────────────────────────────────────────────────
// TIMEFRAME GUARD  (spec section 10)
// ────────────────────────────────────────────────────────────
if not (timeframe.isminutes and timeframe.multiplier == 1)
    runtime.error("Confirmed Sunrise Zones requires a 1-minute (1M) chart.\nPlease switch to a 1-minute timeframe.")

// ────────────────────────────────────────────────────────────
// USER INPUTS
// ────────────────────────────────────────────────────────────

// Data Source
string i_github_repo = input.string(
     defval  = "YOUR_GITHUB_USERNAME/sunrise-seed-data",
     title   = "GitHub Repo  (username/repo-name)",
     tooltip = "Public GitHub repository containing the sunrise CSV files generated by the Python data service.\nExample: johndoe/sunrise-seed-data",
     group   = "Data Source")

// Cities
bool i_show_tokyo  = input.bool(true,  "Show Tokyo",    group = "Cities")
bool i_show_london = input.bool(true,  "Show London",   group = "Cities")
bool i_show_nyc    = input.bool(true,  "Show New York", group = "Cities")

// Colors
color i_tokyo_color  = input.color(#E74C3C, "Tokyo Color",    group = "Colors")
color i_london_color = input.color(#27AE60, "London Color",   group = "Colors")
color i_nyc_color    = input.color(#2980B9, "New York Color", group = "Colors")
int   i_transparency = input.int(80, "Zone Fill Transparency (0=opaque, 95=faint)",
      minval = 0, maxval = 95, group = "Colors")
bool  i_border_visible = input.bool(true, "Show Zone Border", group = "Colors")
int   i_border_width   = input.int(1, "Border Width", minval = 1, maxval = 3, group = "Colors")

// Labels
bool   i_show_labels = input.bool(true, "Show Labels", group = "Labels")
string i_label_size  = input.string("small", "Label Size",
      options = ["tiny", "small", "normal"], group = "Labels")

// Diagnostics
bool i_show_diagnostics = input.bool(false, "Show Diagnostic Audit Table",
     tooltip = "Shows all active sunrise records in a table: City | Local Date | Source Time | TZ | UTC Candle | Status",
     group   = "Diagnostics")

// ────────────────────────────────────────────────────────────
// DATA INGESTION via request.seed()  (spec section 3)
// ────────────────────────────────────────────────────────────
// When tk_hhmm is not na on a given bar, that bar IS the sunrise candle.
// The OHLCV values carry encoded sunrise metadata (see encoding table above).
// The actual chart HIGH and LOW of that bar are used for the zone geometry.

[tk_hhmm, tk_sec, tk_date, tk_status, _tk_v] = request.seed(
     source                = i_github_repo,
     symbol                = "ZONES_TOKYO",
     expression            = [open, high, low, close, volume],
     ignore_invalid_symbol = false)

[ln_hhmm, ln_sec, ln_date, ln_status, _ln_v] = request.seed(
     source                = i_github_repo,
     symbol                = "ZONES_LONDON",
     expression            = [open, high, low, close, volume],
     ignore_invalid_symbol = false)

[ny_hhmm, ny_sec, ny_date, ny_status, _ny_v] = request.seed(
     source                = i_github_repo,
     symbol                = "ZONES_NYC",
     expression            = [open, high, low, close, volume],
     ignore_invalid_symbol = false)

// ────────────────────────────────────────────────────────────
// USER-DEFINED TYPE
// ────────────────────────────────────────────────────────────
type SunriseZone
    box    zone_box
    label  zone_label
    string city_name        // "TOKYO" | "LONDON" | "NEW YORK"
    string iana_tz          // "Asia/Tokyo" | "Europe/London" | "America/New_York"
    int    local_date_int   // YYYYMMDD  e.g. 20260914
    int    sunrise_hhmm     // e.g. 522  (means 05:22)
    int    sunrise_sec      // e.g. 37
    int    status_code      // 1=VERIFIED  2=WARNING  0=UNAVAILABLE
    float  zone_high        // candle HIGH at time of zone creation
    float  zone_low         // candle LOW at time of zone creation
    int    candle_time_ms   // UTC ms of the matched candle open

// ────────────────────────────────────────────────────────────
// PERSISTENT STATE
// ────────────────────────────────────────────────────────────
var array<SunriseZone> active_zones  = array.new<SunriseZone>()
var int                MAX_DAYS      = 12
var table              diag_tbl      = na
var table              info_tbl      = na
var label              warn_lbl      = na

// ────────────────────────────────────────────────────────────
// HELPER FUNCTIONS
// ────────────────────────────────────────────────────────────

// HHMM integer -> "HH:MM" string
f_hhmm(int hhmm) =>
    int hh = math.floor(hhmm / 100)
    int mm = hhmm - hh * 100
    str.format("{0,number,00}:{1,number,00}", hh, mm)

// HHMM + seconds -> "HH:MM:SS" string
f_hhmmss(int hhmm, int ss) =>
    int hh = math.floor(hhmm / 100)
    int mm = hhmm - hh * 100
    str.format("{0,number,00}:{1,number,00}:{2,number,00}", hh, mm, ss)

// YYYYMMDD integer -> "YYYY-MM-DD" string
f_date(int d) =>
    int yyyy = math.floor(d / 10000)
    int mo   = math.floor((d - yyyy * 10000) / 100)
    int dy   = d - yyyy * 10000 - mo * 100
    str.format("{0}-{1,number,00}-{2,number,00}", yyyy, mo, dy)

// Status code -> display string
f_status(int code) =>
    code == 1 ? "VERIFIED" : code == 2 ? "WARNING" : "UNAVAILABLE"

// Status code -> display color
f_status_color(int code) =>
    code == 1 ? color.new(color.green,  0) :
     code == 2 ? color.new(color.orange, 0) :
     color.new(color.red, 0)

// City name -> IANA timezone string
f_tz(string city) =>
    city == "TOKYO"    ? "Asia/Tokyo"       :
     city == "LONDON"   ? "Europe/London"    :
     city == "NEW YORK" ? "America/New_York" : "UTC"

// Label size string -> Pine size constant
f_lbl_size(string sz) =>
    sz == "tiny"   ? size.tiny  :
     sz == "normal" ? size.normal :
     size.small

// ────────────────────────────────────────────────────────────
// ZONE CREATION  (spec sections 9, 12, 21)
// ────────────────────────────────────────────────────────────
// Called on the exact candle where seed data is present.
// Creates a wick-to-wick box extending rightward.

create_zone(string city_name, float f_hhmm, float f_sec,
            float f_date_f, float f_status_f, color zone_color) =>

    SunriseZone result = na

    // Guard: all encoded values must be present
    if na(f_hhmm) or na(f_sec) or na(f_date_f) or na(f_status_f)
        na
    else
        // FUTURE-DATE GUARD: bar open time must be in the past
        // (Python service also enforces this, but belt-and-suspenders)
        if time >= timenow
            na
        else
            int   hhmm        = int(f_hhmm)
            int   sec         = int(f_sec)
            int   date_int    = int(f_date_f)
            int   status_code = int(f_status_f)
            float bar_hi      = high   // real chart candle HIGH
            float bar_lo      = low    // real chart candle LOW
            int   bar_ts      = int(time)

            // Zone geometry: wick-to-wick, extend rightward
            color fill   = color.new(zone_color, i_transparency)
            color border = i_border_visible ? color.new(zone_color, 0) : color.new(color.white, 100)

            box b = box.new(
                 left         = bar_index,
                 top          = bar_hi,
                 right        = bar_index,
                 bottom       = bar_lo,
                 bgcolor      = fill,
                 border_color = border,
                 border_width = i_border_width,
                 extend       = extend.right,
                 xloc         = xloc.bar_index)

            // Label
            label lbl = na
            if i_show_labels
                string time_str = sec > 0 ? f_hhmmss(hhmm, sec) : f_hhmm(hhmm)
                string lbl_txt  = city_name + "\n" + time_str
                lbl := label.new(
                     x         = bar_index,
                     y         = bar_hi,
                     text      = lbl_txt,
                     style     = label.style_label_down,
                     color     = color.new(zone_color, 15),
                     textcolor = color.white,
                     size      = f_lbl_size(i_label_size),
                     xloc      = xloc.bar_index,
                     yloc      = yloc.price)

            result := SunriseZone.new(
                 zone_box      = b,
                 zone_label    = lbl,
                 city_name     = city_name,
                 iana_tz       = f_tz(city_name),
                 local_date_int = date_int,
                 sunrise_hhmm  = hhmm,
                 sunrise_sec   = sec,
                 status_code   = status_code,
                 zone_high     = bar_hi,
                 zone_low      = bar_lo,
                 candle_time_ms = bar_ts)

    result

// ────────────────────────────────────────────────────────────
// ROLLING WINDOW ENFORCEMENT  (spec sections 5, 23)
// ────────────────────────────────────────────────────────────
// Keeps only the 12 most recent calendar dates.
// Explicitly deletes expired boxes and labels.
// DOES NOT rely on TradingView garbage collection.

enforce_rolling_window() =>
    if active_zones.size() > 0
        // Collect all unique local dates across active zones
        array<int> unique_dates = array.new<int>()
        for i = 0 to active_zones.size() - 1
            SunriseZone z = active_zones.get(i)
            if not na(z) and not na(z.zone_box)
                if not array.includes(unique_dates, z.local_date_int)
                    unique_dates.push(z.local_date_int)

        // Sort descending: most recent date first
        unique_dates.sort(order.descending)

        // Build keep-set: top MAX_DAYS dates
        array<int> keep_set = array.new<int>()
        int limit = math.min(MAX_DAYS, unique_dates.size())
        for i = 0 to limit - 1
            keep_set.push(unique_dates.get(i))

        // Remove zones not in keep-set (iterate in reverse to avoid index shifting)
        int i = active_zones.size() - 1
        while i >= 0
            SunriseZone z = active_zones.get(i)
            bool expired = na(z) or na(z.zone_box) or
                           not array.includes(keep_set, z.local_date_int)
            if expired
                if not na(z)
                    if not na(z.zone_box)
                        box.delete(z.zone_box)
                    if not na(z.zone_label)
                        label.delete(z.zone_label)
                active_zones.remove(i)
            i -= 1

// ────────────────────────────────────────────────────────────
// PLACEHOLDER REPO CHECK
// ────────────────────────────────────────────────────────────
bool is_placeholder = str.contains(i_github_repo, "YOUR_GITHUB_USERNAME")

// ────────────────────────────────────────────────────────────
// MAIN BAR LOGIC  (runs on every bar)
// ────────────────────────────────────────────────────────────

// Tokyo
if i_show_tokyo and not na(tk_hhmm) and not is_placeholder
    SunriseZone z = create_zone("TOKYO",    tk_hhmm, tk_sec, tk_date, tk_status, i_tokyo_color)
    if not na(z) and not na(z.zone_box)
        active_zones.push(z)

// London
if i_show_london and not na(ln_hhmm) and not is_placeholder
    SunriseZone z = create_zone("LONDON",   ln_hhmm, ln_sec, ln_date, ln_status, i_london_color)
    if not na(z) and not na(z.zone_box)
        active_zones.push(z)

// New York
if i_show_nyc and not na(ny_hhmm) and not is_placeholder
    SunriseZone z = create_zone("NEW YORK", ny_hhmm, ny_sec, ny_date, ny_status, i_nyc_color)
    if not na(z) and not na(z.zone_box)
        active_zones.push(z)

// Enforce rolling 12-day window
enforce_rolling_window()

// ────────────────────────────────────────────────────────────
// LAST-BAR ONLY: tables and warnings
// ────────────────────────────────────────────────────────────
if barstate.islast

    // Setup warning when repo not configured
    if not na(warn_lbl)
        label.delete(warn_lbl)
    if is_placeholder
        warn_lbl := label.new(
             x         = bar_index,
             y         = high,
             text      = "Confirmed Sunrise Zones\n\nSetup required:\nSettings -> Data Source\n-> Enter your GitHub repo",
             style     = label.style_label_left,
             color     = color.new(color.orange, 10),
             textcolor = color.white,
             size      = size.normal,
             xloc      = xloc.bar_index,
             yloc      = yloc.abovebar)

    // Info table (bottom-right, always visible)
    if not na(info_tbl)
        table.delete(info_tbl)
    info_tbl := table.new(
         position     = position.bottom_right,
         columns      = 2,
         rows         = 4,
         bgcolor      = color.new(color.black, 25),
         frame_color  = color.new(color.gray, 50),
         frame_width  = 1,
         border_color = color.new(color.gray, 60),
         border_width = 1)

    table.cell(info_tbl, 0, 0, "Confirmed Sunrise Zones",
         text_color = color.white, text_size = size.small,
         text_halign = text.align_left,
         bgcolor = color.new(#1a2a4a, 10))
    table.cell(info_tbl, 1, 0, "v1.0",
         text_color = color.new(color.silver, 0), text_size = size.tiny,
         text_halign = text.align_right,
         bgcolor = color.new(#1a2a4a, 10))

    table.cell(info_tbl, 0, 1, "Active Zones",
         text_color = color.new(color.silver, 0), text_size = size.tiny,
         text_halign = text.align_left)
    table.cell(info_tbl, 1, 1, str.tostring(active_zones.size()) + " / 36",
         text_color = color.white, text_size = size.tiny,
         text_halign = text.align_right)

    table.cell(info_tbl, 0, 2, "Repository",
         text_color = color.new(color.silver, 0), text_size = size.tiny,
         text_halign = text.align_left)
    string repo_disp = is_placeholder ? "NOT CONFIGURED" : i_github_repo
    color  repo_col  = is_placeholder ? color.orange : color.new(color.silver, 0)
    table.cell(info_tbl, 1, 2, repo_disp,
         text_color = repo_col, text_size = size.tiny,
         text_halign = text.align_right)

    table.cell(info_tbl, 0, 3, "Source",
         text_color = color.new(color.silver, 0), text_size = size.tiny,
         text_halign = text.align_left)
    table.cell(info_tbl, 1, 3, "timeanddate.com",
         text_color = color.new(color.teal, 0), text_size = size.tiny,
         text_halign = text.align_right)

    // Diagnostic audit table (optional)
    if i_show_diagnostics
        if not na(diag_tbl)
            table.delete(diag_tbl)

        int n  = active_zones.size()
        int nr = n + 2  // title row + header row + data rows

        diag_tbl := table.new(
             position     = position.top_right,
             columns      = 7,
             rows         = math.max(nr, 3),
             bgcolor      = color.new(color.black, 15),
             frame_color  = color.new(color.gray, 40),
             frame_width  = 1,
             border_color = color.new(color.gray, 60),
             border_width = 1)

        // Title row (span 7 columns via padding)
        string title = "Confirmed Sunrise Zones - Audit Table  |  " +
             str.tostring(n) + " zones active (max 36)  |  Source: timeanddate.com"
        table.cell(diag_tbl, 0, 0, title,
             text_color = color.white, text_size = size.small,
             text_halign = text.align_left,
             bgcolor = color.new(#0d1b2a, 0))
        for c = 1 to 6
            table.cell(diag_tbl, c, 0, "",
                 bgcolor = color.new(#0d1b2a, 0))

        // Header row
        color hbg = color.new(#1a2a4a, 0)
        color hfg = color.new(color.silver, 0)
        string[] hdrs = array.from("City","Local Date","Source Time","Timezone","UTC Candle","Hi / Lo","Status")
        for c = 0 to 6
            table.cell(diag_tbl, c, 1, hdrs.get(c),
                 text_color = hfg, text_size = size.tiny,
                 text_halign = text.align_center, bgcolor = hbg)

        // Data rows
        for i = 0 to n - 1
            SunriseZone z = active_zones.get(i)
            int row = i + 2
            if na(z) or na(z.zone_box)
                continue

            string stime = z.sunrise_sec > 0 ? f_hhmmss(z.sunrise_hhmm, z.sunrise_sec) : f_hhmm(z.sunrise_hhmm)
            string utc_str = str.format_time(z.candle_time_ms, "yyyy-MM-dd HH:mm", "UTC") + " UTC"
            string hilo    = str.tostring(z.zone_high, "#.####") + " / " + str.tostring(z.zone_low, "#.####")

            color city_col = z.city_name == "TOKYO" ? i_tokyo_color : z.city_name == "LONDON" ? i_london_color : i_nyc_color
            color rbg = i % 2 == 0 ? color.new(color.black, 55) : color.new(color.black, 70)

            string[] cells = array.from(
                 z.city_name, f_date(z.local_date_int), stime,
                 z.iana_tz, utc_str, hilo, f_status(z.status_code))

            for c = 0 to 6
                color fg = c == 0 ? city_col :
                           c == 6 ? f_status_color(z.status_code) :
                           color.new(color.silver, 0)
                table.cell(diag_tbl, c, row, cells.get(c),
                     text_color = fg, text_size = size.tiny,
                     text_halign = text.align_center, bgcolor = rbg)
